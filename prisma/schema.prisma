generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PrepVisibility {
  private
  link
  public
}

/// Mirrors `SUPPORTED_LANGUAGES` in `src/lib/config.ts`; a test keeps them in sync.
enum Language {
  en
  de
  fr
  it
  es
  pl
  nl
  pt
  ru
  uk
}

enum PrepDiscipline {
  History
  Geography
  Literature
  SocialStudies    @map("Social Studies")
  Economics
  PhilosophyEthics @map("Philosophy/Ethics")
  Biology
  Chemistry
  Physics
  Mathematics
  ComputerScience  @map("Computer Science")
  English
  French
  German
  Spanish
  Italian
  Latin
  Russian
}

/// Derived from the prep's jobs and stored; `syncPrepStatus` (src/repositories/jobRepository.ts) is its only writer.
enum PrepStatus {
  draft
  processing
  ready
  failed
}

model Prep {
  id         String          @id @default(uuid())
  userId     String
  title      String
  createdAt  DateTime        @default(now())
  visibility PrepVisibility  @default(private)
  grade      Int?
  discipline PrepDiscipline?
  language   Language?

  description String          @default("")
  isActive    Boolean         @default(false)
  status      PrepStatus      @default(draft)

  questions   Question[]
  attempts    Attempt[]
  images      PrepImage[]
  jobs        Job[]
  @@index([userId])
  @@index([visibility, isActive, createdAt])
}

enum PrepImageStatus {
  pending
  processing
  done
  failed
}

model PrepImage {
  id              String          @id @default(uuid())
  prepId          String
  gcsKey          String
  status          PrepImageStatus @default(pending)
  ocrResult       Json?
  // Detected by the `ocr` job; null until then.
  language        Language?
  error           String?
  // Set by the `ocr` job (#270); null until then, or if that job is deleted.
  producedByJobId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now())

  prep          Prep @relation(fields: [prepId], references: [id], onDelete: Cascade)
  producedByJob Job? @relation(fields: [producedByJobId], references: [id], onDelete: SetNull)
  @@index([prepId])
}

model Question {
  id        String   @id @default(uuid())
  prepId    String
  type      String
  // Null only for rows created before difficulty tiers existed.
  difficulty String?
  language  Language
  content   Json
  // Set by the `question` job (#273); null only if that job is deleted.
  producedByJobId String?
  createdAt       DateTime @default(now())

  prep          Prep    @relation(fields: [prepId], references: [id], onDelete: Cascade)
  assets        Asset[]
  producedByJob Job?    @relation(fields: [producedByJobId], references: [id], onDelete: SetNull)
  @@index([prepId])
}

model Attempt {
  id        String   @id @default(uuid())
  prepId    String
  userId    String
  score     Int
  total     Int
  createdAt DateTime @default(now())

  prep Prep @relation(fields: [prepId], references: [id], onDelete: Cascade)
  @@index([prepId, userId])
}

// One row per LLM call, linked to the job it ran for; a Prep's usage/cost is the sum over its jobs (#31).
model GenerationMeta {
  id               String   @id @default(uuid())
  jobId            String
  model            String
  tier             String
  promptTokens     Int
  cachedTokens     Int
  completionTokens Int
  costUsd          Float
  toolCalls        Int
  executionMs      Int
  // Billed but discarded: the call's output isn't the one that became the final Question.
  wasted           Boolean  @default(false)
  generatedAt      DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Asset {
  id         String   @id @default(uuid())
  // One asset per question.
  questionId String   @unique
  type       String
  blob       String
  // Set by the `asset` job; null for assets generated before it existed, or if that job is deleted.
  producedByJobId String?
  createdAt  DateTime @default(now())

  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  producedByJob Job?     @relation(fields: [producedByJobId], references: [id], onDelete: SetNull)
}

// Runtime-agnostic job model — see wiki ADR-Pipeline-Job-Model. Mirrors the `Job` discriminated
// union in src/core/job.ts: `output`/`failureReason` are set by exactly one of `executed`/`failed`,
// enforced by PrismaStore (src/repositories/jobRepository.ts), not by the database.
enum JobStatus {
  created
  running
  interrupted
  executed
  failed
  superseded
}

model Job {
  id            String    @id @default(uuid())
  prepId        String
  // Not an enum: a new job type (#272, #273, ...) needs no schema change (ADR point 1).
  type          String
  status        JobStatus @default(created)
  // Resolved ExecutionConfig (src/core/job.ts) — never an API key, which is supplied only at execution.
  model         String
  tier          String
  timeoutMs     Int
  maxRetries    Int
  // Runs that claimed this job; a `failed` one at MAX_JOB_ATTEMPTS is terminal until the user retries it.
  attempts      Int       @default(0)
  // A `question` job's task spec (#273) — not entities, so JobInput can't carry them. Null for other job types.
  questionType  String?
  difficulty    String?
  output        Json?
  failureReason String?
  // Set while `running` and refreshed by the runner (~30s); a stale one means the process died (read as `interrupted`).
  heartbeatAt   DateTime?
  createdBy     String
  executedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())

  prep              Prep             @relation(fields: [prepId], references: [id], onDelete: Cascade)
  inputs            JobInput[]
  concepts          Concept[]
  producedImages    PrepImage[]
  producedQuestions Question[]
  producedAssets    Asset[]
  generationMetas   GenerationMeta[]
  @@index([prepId, type, status])
}

// Join table for a job's input entities (ADR point 4) — keeps the dependency graph queryable
// without a job-to-job graph. `entityType` is a plain string, not an enum, for the same reason
// as `Job.type`: a new input entity type needs no schema change.
model JobInput {
  id         String @id @default(uuid())
  jobId      String
  entityType String
  entityId   String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([jobId])
}

// Same shape as conceptSchema (src/types/pipeline.ts). Produced only by a `concepts` job
// (#272) — no concept exists independently of the job that produced it.
model Concept {
  id              String   @id @default(uuid())
  name            String
  description     String
  importance      Float
  misconceptions  String[]
  language        Language
  producedByJobId String
  createdAt       DateTime @default(now())

  producedByJob Job @relation(fields: [producedByJobId], references: [id], onDelete: Cascade)
  @@index([producedByJobId])
}
