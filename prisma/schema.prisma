generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PrepVisibility {
  private
  link
  public
}

enum PrepDiscipline {
  History
  Geography
  Literature
  SocialStudies    @map("Social Studies")
  Economics
  PhilosophyEthics @map("Philosophy/Ethics")
  Biology
  Chemistry
  Physics
  Mathematics
  ComputerScience  @map("Computer Science")
  English
  French
  German
  Spanish
  Italian
  Latin
  Russian
}

model Prep {
  id         String          @id @default(uuid())
  userId     String
  title      String
  // TODO(#41): opaque JSON today; #41's resilient-upload work may want
  // per-page status tracking, which would need this as its own model.
  pages      Json?
  createdAt  DateTime        @default(now())
  tokensUsed Int             @default(0)
  visibility PrepVisibility  @default(private)
  grade      Int?
  discipline PrepDiscipline?
  language   String?

  description String          @default("")
  isActive    Boolean         @default(false)

  questions   Question[]
  attempts    Attempt[]
  pipelineRun PipelineRun?
}

model Question {
  id        String   @id @default(uuid())
  prepId    String
  type      String
  // Null only for rows created before difficulty tiers existed.
  difficulty String?
  content   Json
  createdAt DateTime @default(now())

  prep   Prep    @relation(fields: [prepId], references: [id], onDelete: Cascade)
  assets Asset[]
}

model Attempt {
  id        String   @id @default(uuid())
  prepId    String
  userId    String
  mode      String
  score     Int
  total     Int
  createdAt DateTime @default(now())

  prep Prep @relation(fields: [prepId], references: [id], onDelete: Cascade)
}

// Optional, not 1:1 with Prep: created lazily when generation starts
// (pipelineStore.loadOrCreateRun), not at prep creation.
model PipelineRun {
  id        String   @id @default(uuid())
  prepId    String   @unique
  // TODO(#41): concepts as first-class citizens may want their own model
  // instead of opaque JSON.
  concepts      Json?
  questionTasks Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  prep      Prep               @relation(fields: [prepId], references: [id], onDelete: Cascade)
  questions PipelineQuestion[]
}

enum PipelineQuestionStatus {
  pending
  finished
  failed
}

model PipelineQuestion {
  id        String                 @id @default(uuid())
  runId     String
  taskIndex Int
  task      Json
  status    PipelineQuestionStatus @default(pending)
  // Per-attempt build/review state, in attempt order — lets crash-resume continue from the
  // last completed step (build, or build+review) instead of redoing the whole slot. Shape:
  // { attemptNum, build: {question, meta}, review: {review, passed, meta} | null }[].
  // `status: pending` with a non-empty attempts array means resumable; `failed` is terminal
  // (max attempts exhausted) and is never retried on resume.
  attempts  Json                   @default("[]")
  // Final question + its build/review AgentMeta, set once status = finished.
  question  Json?
  meta      Json?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @default(now())

  run PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, taskIndex])
}

enum GenerationEntityType {
  prep
  question
}

// Polymorphic (entityType + entityId) rather than per-entity FKs: usage/cost needs to
// aggregate across an entity's own generation calls today, and across related entities
// (e.g. total cost for a Prep across all its Questions) once that reporting lands (#31).
model GenerationMeta {
  id               String               @id @default(uuid())
  entityType       GenerationEntityType
  entityId         String
  model            String
  tier             String
  promptTokens     Int
  cachedTokens     Int
  completionTokens Int
  costUsd          Float
  toolCalls        Int
  executionMs      Int
  // Billed but discarded: the call's output isn't the one that became the final Question.
  wasted           Boolean              @default(false)
  generatedAt      DateTime             @default(now())

  @@index([entityType, entityId])
}

model Asset {
  id         String   @id @default(uuid())
  questionId String
  type       String
  blob       String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
