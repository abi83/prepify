generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PrepVisibility {
  private
  link
  public
}

enum PrepDiscipline {
  History
  Geography
  Literature
  SocialStudies    @map("Social Studies")
  Economics
  PhilosophyEthics @map("Philosophy/Ethics")
  Biology
  Chemistry
  Physics
  Mathematics
  ComputerScience  @map("Computer Science")
  English
  French
  German
  Spanish
  Italian
  Latin
  Russian
}

model Prep {
  id         String          @id @default(uuid())
  userId     String
  title      String
  createdAt  DateTime        @default(now())
  tokensUsed Int             @default(0)
  visibility PrepVisibility  @default(private)
  grade      Int?
  discipline PrepDiscipline?
  language   String?

  description String          @default("")
  isActive    Boolean         @default(false)

  questions   Question[]
  attempts    Attempt[]
  pipelineRun PipelineRun?
  images      PrepImage[]
  jobs        Job[]
}

enum PrepImageStatus {
  pending
  processing
  done
  failed
}

model PrepImage {
  id              String          @id @default(uuid())
  prepId          String
  gcsKey          String
  status          PrepImageStatus @default(pending)
  ocrResult       Json?
  error           String?
  // Null for rows OCR'd by the legacy pipeline (src/lib/prepImageOcr.ts) — only the `ocr`
  // job (#270) sets this.
  producedByJobId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now())

  prep          Prep @relation(fields: [prepId], references: [id], onDelete: Cascade)
  producedByJob Job? @relation(fields: [producedByJobId], references: [id], onDelete: SetNull)
}

model Question {
  id        String   @id @default(uuid())
  prepId    String
  type      String
  // Null only for rows created before difficulty tiers existed.
  difficulty String?
  content   Json
  // Null for rows built by the legacy pipeline (src/lib/pipeline.ts) — only a `question`
  // job (#273) sets this.
  producedByJobId String?
  createdAt       DateTime @default(now())

  prep          Prep    @relation(fields: [prepId], references: [id], onDelete: Cascade)
  assets        Asset[]
  producedByJob Job?    @relation(fields: [producedByJobId], references: [id], onDelete: SetNull)
}

model Attempt {
  id        String   @id @default(uuid())
  prepId    String
  userId    String
  mode      String
  score     Int
  total     Int
  createdAt DateTime @default(now())

  prep Prep @relation(fields: [prepId], references: [id], onDelete: Cascade)
}

// Optional, not 1:1 with Prep: created lazily when generation starts
// (pipelineStore.loadOrCreateRun), not at prep creation.
model PipelineRun {
  id        String   @id @default(uuid())
  prepId    String   @unique
  // TODO(#41): concepts as first-class citizens may want their own model
  // instead of opaque JSON.
  concepts      Json?
  questionTasks Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  prep      Prep               @relation(fields: [prepId], references: [id], onDelete: Cascade)
  questions PipelineQuestion[]
}

enum PipelineQuestionStatus {
  pending
  finished
  failed
}

model PipelineQuestion {
  id        String                 @id @default(uuid())
  runId     String
  taskIndex Int
  task      Json
  status    PipelineQuestionStatus @default(pending)
  // Per-attempt build/review state, in attempt order — lets crash-resume continue from the
  // last completed step (build, or build+review) instead of redoing the whole slot. Shape:
  // { attemptNum, build: {question, meta}, review: {review, passed, meta} | null }[].
  // `status: pending` with a non-empty attempts array means resumable; `failed` is terminal
  // (max attempts exhausted) and is never retried on resume.
  attempts  Json                   @default("[]")
  // Final question + its build/review AgentMeta, set once status = finished.
  question  Json?
  meta      Json?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @default(now())

  run PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, taskIndex])
}

enum GenerationEntityType {
  prep
  question
}

// Polymorphic (entityType + entityId) rather than per-entity FKs: usage/cost needs to
// aggregate across an entity's own generation calls today, and across related entities
// (e.g. total cost for a Prep across all its Questions) once that reporting lands (#31).
model GenerationMeta {
  id               String               @id @default(uuid())
  entityType       GenerationEntityType
  entityId         String
  model            String
  tier             String
  promptTokens     Int
  cachedTokens     Int
  completionTokens Int
  costUsd          Float
  toolCalls        Int
  executionMs      Int
  // Billed but discarded: the call's output isn't the one that became the final Question.
  wasted           Boolean              @default(false)
  generatedAt      DateTime             @default(now())
  // Null for rows recorded by the legacy pipeline — only a job-backed LLM call (#270) sets
  // this. Replaces entityType/entityId as the cost link once the legacy pipeline is gone (#275).
  jobId            String?

  job Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model Asset {
  id         String   @id @default(uuid())
  questionId String
  type       String
  blob       String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Runtime-agnostic job model — see wiki ADR-Pipeline-Job-Model. Mirrors the `Job` discriminated
// union in src/core/job.ts: `output`/`failureReason` are set by exactly one of `executed`/`failed`,
// enforced by PrismaStore (src/repositories/jobRepository.ts), not by the database.
enum JobStatus {
  created
  executed
  failed
}

model Job {
  id            String    @id @default(uuid())
  prepId        String
  // Not an enum: a new job type (#272, #273, ...) needs no schema change (ADR point 1).
  type          String
  status        JobStatus @default(created)
  // Resolved ExecutionConfig (src/core/job.ts) — never an API key, which is supplied only at execution.
  model         String
  tier          String
  timeoutMs     Int
  maxRetries    Int
  output        Json?
  failureReason String?
  createdBy     String
  executedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())

  prep              Prep             @relation(fields: [prepId], references: [id], onDelete: Cascade)
  inputs            JobInput[]
  concepts          Concept[]
  producedImages    PrepImage[]
  producedQuestions Question[]
  generationMetas   GenerationMeta[]
}

// Join table for a job's input entities (ADR point 4) — keeps the dependency graph queryable
// without a job-to-job graph. `entityType` is a plain string, not an enum, for the same reason
// as `Job.type`: a new input entity type needs no schema change.
model JobInput {
  id         String @id @default(uuid())
  jobId      String
  entityType String
  entityId   String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

// Same shape as conceptSchema (src/types/pipeline.ts). Produced only by a `concepts` job
// (#272) — no concept exists independently of the job that produced it.
model Concept {
  id              String   @id @default(uuid())
  name            String
  description     String
  importance      Float
  misconceptions  String[]
  producedByJobId String
  createdAt       DateTime @default(now())

  producedByJob Job @relation(fields: [producedByJobId], references: [id], onDelete: Cascade)
}
