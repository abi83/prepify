# Setup: brew install direnv; add eval "$(direnv hook zsh)" to ~/.zshrc (or bash); then: direnv allow
# Requires: gcloud auth login

set -euo pipefail

GCP_PROJECT=${PREPIFY_GCP_PROJECT:-prepify-dev-vk}

export DATABASE_URL_DIRECT=$(gcloud secrets versions access latest --secret=database-url-direct --project="$GCP_PROJECT")
export DATABASE_URL_POOLING=$(gcloud secrets versions access latest --secret=database-url-pooling --project="$GCP_PROJECT")
export AUTH_SECRET=$(gcloud secrets versions access latest --secret=auth-secret --project="$GCP_PROJECT")
export AUTH_GOOGLE_CLIENT_ID=$(gcloud secrets versions access latest --secret=auth-google-client-id --project="$GCP_PROJECT")
export AUTH_GOOGLE_CLIENT_SECRET=$(gcloud secrets versions access latest --secret=auth-google-client-secret --project="$GCP_PROJECT")

# GCS uses Workload Identity in Cloud Run — no local key. App boots but GCS calls fail locally. See #251.
export GCS_BUCKET_NAME="${GCP_PROJECT}-storage"
