{
  "mcpServers": {
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp?projectId=fragrant-shape-93094350",
      "headers": {
        "Authorization": "Bearer ${NEON_DEV_API_KEY}"
      }
    },
    "gcp_logging": {
      "type": "http",
      "url": "https://logging.googleapis.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GCP_LOGS_TOKEN}",
        "x-goog-user-project": "prepify-dev-vk"
      }
    },
    "gcs": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@google-cloud/storage-mcp@0.6.0"],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "prepify-dev-vk",
        "GOOGLE_APPLICATION_CREDENTIALS": "${HOME}/.config/prepify-gcs-reader/application_default_credentials.json"
      }
    }
  }
}
