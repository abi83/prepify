{
  "mcpServers": {
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp",
      "headers": {
        "Authorization": "Bearer ${NEON_DEV_API_KEY}"
      }
    },
    "gcp_logging": {
      "type": "http",
      "url": "https://logging.googleapis.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GCP_LOGS_TOKEN}",
        "x-goog-user-project": "prepify-dev-vk"
      }
    }
  }
}
